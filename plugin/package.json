{
  "name": "ddeck-remote",
  "version": "0.9.16-beta",
  "private": false,
  "type": "module",
  "description": "Connect your phone to DeepSeek Harness: one code on the computer, one scan on the phone.",
  "license": "Apache-2.0",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib",
    "relay",
    "cordis.patch.yml",
    "install.sh",
    "install.ps1",
    "install.cmd",
    "uninstall.sh",
    "uninstall.ps1",
    "icon.svg",
    "locale/*.json",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD-PARTY-LICENSES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nemezida1337/ddeck-client.git"
  },
  "homepage": "https://github.com/nemezida1337/ddeck-client#readme",
  "bugs": {
    "url": "https://github.com/nemezida1337/ddeck-client/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "remote",
    "android",
    "plugin"
  ],
  "engines": {
    "dsh": "^0.1.5-rc.1 || ^0.2.1-rc.2 || ^0.2.2-alpha.2"
  },
  "devDependencies": {
    "qrcode": "^1.5.4",
    "node-forge": "^1.3.1",
    "esbuild": "^0.28.2"
  }
}
