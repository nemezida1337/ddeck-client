{
  "name": "dsh-remote",
  "version": "0.9.2-beta",
  "private": true,
  "type": "module",
  "description": "Connect your phone to DeepSeek Harness: one code on the computer, one scan on the phone.",
  "license": "Apache-2.0",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD-PARTY-LICENSES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "engines": {
    "dsh": "^0.1.5-rc.1 || ^0.2.1-rc.2"
  },
  "devDependencies": {
    "qrcode": "^1.5.4",
    "node-forge": "^1.3.1",
    "esbuild": "^0.28.2"
  }
}
