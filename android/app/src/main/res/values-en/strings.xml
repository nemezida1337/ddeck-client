<?xml version="1.0" encoding="utf-8"?>
<!--
  English translation of every user-facing string in the shell.

  Russian is the default language (`values/`), so this file must stay complete: a
  missing entry would silently fall back to Russian on an English phone. Strings
  marked `translatable="false"` in the default file (the product name and example
  addresses) are intentionally absent here.
-->
<resources>

  <!-- Connection screen. -->
  <string name="connect_subtitle">Connect to a computer running DeepSeek Harness</string>
  <string name="connect_origin_label">Computer address</string>
  <string name="connect_key_label">Pairing key</string>
  <string name="connect_key_hint">one-time key from the “DDeck” panel</string>
  <string name="connect_scan_qr">Scan the QR code from the computer</string>
  <string name="connect_pair">Pair and connect</string>
  <string name="connect_saved_label">Paired computers</string>
  <string name="connect_saved_empty">None yet. Pair your first computer — it will appear here.</string>
  <string name="connect_forget">Forget</string>
  <string name="connect_qr_prompt">Point the camera at the QR code in the “DDeck” panel</string>
  <string name="connect_need_origin_or_link">An address with a key or an invite link is required</string>
  <string name="connect_pairing">Pairing…</string>
  <string name="connect_paired">Paired: %1$s</string>
  <string name="connect_reconnecting">Reconnecting to %1$s…</string>
