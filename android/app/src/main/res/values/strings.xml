<?xml version="1.0" encoding="utf-8"?>
<!--
  Все пользовательские строки оболочки.

  Русский — язык по умолчанию: он лежит в `values/`, английский перевод — в
  `values-en/`. Ни одна строка интерфейса не должна оставаться в Kotlin: текст,
  зашитый в код, нельзя перевести, и он же попадает в уведомления, которые
  система показывает вне приложения.

  Строки без перевода помечены `translatable="false"`: это название продукта и
  примеры адресов, которые одинаковы в любом языке.
-->
